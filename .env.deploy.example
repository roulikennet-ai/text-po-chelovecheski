# ============================================================================
# Пример конфигурации для деплоя (docker-compose).
# Скопируйте в .env.deploy и впишите свои значения.
# Файл .env.deploy НЕ коммитится в git и не входит в архив.
# Все значения ниже — заглушки: замените их на свои.
# ============================================================================

# Порт web-сервера (отображается в браузере клиента)
PORT=4173

# GigaChat: ключ авторизации (Base64 из личного кабинета Sber Developers).
# Без этого ключа работает только статика и локальные GGUF-модели.
GIGACHAT_AUTH_KEY=

# Модель по умолчанию (необязательно, есть дефолт)
GIGACHAT_MODEL=GigaChat-2

# Токен администратора — длинная случайная строка.
# Придумайте сами:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Без него админ-сводка недоступна (503).
ADMIN_TOKEN=

# Получатель уведомлений о регистрации новых аккаунтов.
# ADMIN_EMAIL=admin@example.com

# -------------------------------------------------------------------------
# Сообщество ВКонтакте (необязательно, но рекомендуется)
# -------------------------------------------------------------------------

# Токен сообщества (права: «Сообщения сообщества» + «Управление сообществом»).
# ВАЖНО: нужен именно «Ключ доступа сообщества» из раздела
# Управление → Настройки → Работа с API. Сервисный ключ и ключ пользователя
# для Long Poll не подходят. Права groups/stats недостаточны.
# Получить: https://vk.com → Управление → Работа с API → Создать ключ
VK_ACCESS_TOKEN=

# Числовой ID сообщества (vk.com/@club123456789 → 123456789)
VK_GROUP_ID=

# Короткое имя (screen_name), например "text_by_human"
VK_GROUP_SCREEN=

# Токен подтверждения Callback API (из настроек сообщества → Callback API).
# При включении VK возвращает эту строку в поле confirmation_token.
VK_CONFIRMATION_TOKEN=

# Секретный ключ Callback API (для проверки подлинности событий).
# Если не задан — проверка не проводится.
VK_SECRET=

# -------------------------------------------------------------------------
# Бот сообщества (Long Poll API)
# -------------------------------------------------------------------------

# Кому разрешено пользоваться ботом: id пользователей ВК через запятую.
# Пусто — команды принимает любой участник сообщества.
VK_BOT_ADMINS=

# Сколько секунд держать запрос Long Poll (по умолчанию 25)
VK_LONGPOLL_WAIT=25
