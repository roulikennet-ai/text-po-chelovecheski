# Секреты деплоя — не коммитим
.env.deploy
.env
.env.*
# Шаблоны без секретов остаются в репозитории
!.env.example
!.env.deploy.example

# Ключи API (в API/api.txt лежит ключ авторизации GigaChat)
API/

# Метрики и данные (генерируются на сервере)
app/data/

# Локальные логи
*.log
dev-server.log

# Архивы для передачи проекта
*.zip
