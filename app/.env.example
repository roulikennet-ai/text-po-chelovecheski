# ============================================================================
# GigaChat для web-версии. СКОПИРУЙТЕ этот файл в app/.env и впишите ключ.
#
#   copy .env.example .env      (Windows, cmd/PowerShell)
#
# Файл .env в git не попадает. Ключ читает только сервер (server/gigachat.mjs),
# в браузер он не передаётся и в логи не пишется.
# ============================================================================

# Ключ авторизации из личного кабинета Sber Developers
# (проект → «Ключи авторизации»). Это строка Base64 вида MDE5YjE...
# ВАЖНО: впишите свой ключ. В шаблоне ключа нет и он не коммитится.
GIGACHAT_AUTH_KEY=

# Версия API: GIGACHAT_API_PERS (физлицо), GIGACHAT_API_B2B, GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель по умолчанию
GIGACHAT_MODEL=GigaChat-2

# Адреса можно переопределить, но обычно это не нужно
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE=https://api.giga.chat/v1

# Порт web-сервера
PORT=4173

# Токен администратора для страницы /admin и GET /api/admin/stats.
# Придумайте длинную случайную строку, например:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Без этой переменной админ-сводка отключена (503).
ADMIN_TOKEN=

# Адрес электронной почты администратора — получатель уведомлений о регистрации
# новых аккаунтов (по умолчанию уведомления пишутся в файл).
# ADMIN_EMAIL=admin@example.com

# Файл, куда пишутся метрики запросов и токенов (по умолчанию app/data/metrics.json)
# METRICS_FILE=./data/metrics.json

# ---- Сообщество ВКонтакте (необязательно) ----
# Токен сообщества (права groups, stats). Без него ВК-блок в админке отключён.
# VK_ACCESS_TOKEN=
# Числовой id сообщества и короткое имя
# VK_GROUP_ID=
# VK_GROUP_SCREEN=text_by_human
# Токен подтверждения и секрет Callback API
# VK_CONFIRMATION_TOKEN=
# VK_SECRET=

# ---- Бот сообщества ВКонтакте (Long Poll, необязательно) ----
# Нужен тот же VK_ACCESS_TOKEN, что выше, но с правами «Сообщения» и «Управление».
# Подробная инструкция: VK_BOT.md
# Кому разрешено пользоваться ботом: id пользователей ВК через запятую.
# Пусто — команды принимаются от любого участника сообщества.
# VK_BOT_ADMINS=
# Сколько секунд держать Long Poll запрос (по умолчанию 25)
# VK_LONGPOLL_WAIT=25

# Альтернатива .env: путь к файлу с ключом (по умолчанию ../API/api.txt)
# GIGACHAT_KEY_FILE=../API/api.txt
